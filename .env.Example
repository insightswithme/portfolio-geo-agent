# Random string, at least 16 characters. Opal sends this as Authorization: Bearer <token>.
OPAL_TOOL_SECRET=

PORT=4000

# Comma-separated hosts the tool is allowed to fetch. Private addresses are always blocked.
ALLOWED_HOSTS=insightswithme-github-io-insightswithme.vercel.app

# Optional. Sent as x-vercel-protection-bypass when the portfolio deployment is protected.
VERCEL_BYPASS_SECRET=
